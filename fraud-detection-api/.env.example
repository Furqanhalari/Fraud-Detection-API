# ════════════════════════════════════════════════════════════════════════════════
# Fraud Detection API — Environment Variables Reference
#
# Copy this file to .env and fill in the values before running the server.
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed to version control.
# ════════════════════════════════════════════════════════════════════════════════


# ── Database ──────────────────────────────────────────────────────────────────

# Full SQLAlchemy connection URL.
# SQLite (default, good for development / single-node Replit):
DATABASE_URL=sqlite:///./fraud_detection.db
#
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/fraud_detection


# ── ML Artifacts ──────────────────────────────────────────────────────────────

# Directory where train.py writes and the server reads model artifacts.
# Contains: xgboost_model.pkl, isolation_forest.pkl, scaler.pkl,
#           train_distributions.json, metrics.json
MODEL_PATH=./app/ml/artifacts/


# ── Fraud Scoring ─────────────────────────────────────────────────────────────

# Ensemble score threshold above which a transaction is flagged as fraud.
# Range: 0.0 – 1.0.  Lower = more sensitive (more false positives).
# Use POST /api/v1/backtest to find the optimal value for your data.
FRAUD_THRESHOLD=0.5

# Expected fraction of transactions that are anomalous (Isolation Forest param).
# Typical production credit-card fraud rate: 0.001 – 0.005.
ANOMALY_CONTAMINATION=0.01


# ── Logging ───────────────────────────────────────────────────────────────────

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use INFO in production; DEBUG only for local troubleshooting.
LOG_LEVEL=INFO


# ── Security ──────────────────────────────────────────────────────────────────

# API key sent by clients in the X-API-Key request header.
# Required on all POST routes: /api/v1/predict, /api/v1/backtest,
#   /api/v1/monitoring/drift-snapshot.
# Leave blank to disable auth in local development.
#
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call the API from a browser.
# Defaults to localhost dev ports when this variable is unset or blank.
#
# Development (leave blank):
ALLOWED_ORIGINS=
#
# Production examples:
# ALLOWED_ORIGINS=https://your-app.replit.app,https://admin.example.com


# ── Server (optional — used by the start command) ─────────────────────────────

# Port uvicorn listens on.  Replit sets this automatically via the PORT env var;
# you only need to set it manually in non-Replit environments.
# PORT=8000

# Number of uvicorn worker processes.
# Use 1 on SQLite (SQLite does not support multiple writers).
# Use 2–4 with PostgreSQL.
# WORKERS=1
