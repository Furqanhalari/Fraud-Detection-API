# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fraud_detection.db

# ── ML artifacts ──────────────────────────────────────────────────────────────
MODEL_PATH=./app/ml/artifacts/

# ── Fraud scoring ─────────────────────────────────────────────────────────────
# Fraud score threshold (0.0 – 1.0)
FRAUD_THRESHOLD=0.5

# Isolation Forest contamination rate (fraction of expected outliers)
ANOMALY_CONTAMINATION=0.01

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# API key required on all POST routes via X-API-Key header.
# Leave blank to disable auth in local development.
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Defaults to localhost on common dev ports when unset.
# Production example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
